BOT_TOKEN=your_telegram_bot_token_here
WEBAPP_URL=https://your-public-https-url
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
INIT_DATA_TTL_SECONDS=86400
PROVERKACHEKA_API_TOKEN=your_proverkacheka_api_token_here
# PROVERKACHEKA_API_KEY is also supported as an alias on servers.
PROVERKACHEKA_API_URL=https://proverkacheka.com/api/v1/check/get
PROVERKACHEKA_TIMEOUT_SECONDS=20
LOCAL_OCR_ENABLED=1
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGES=rus+eng
TESSERACT_TIMEOUT_SECONDS=20
TESSERACT_TESSDATA_DIR=tools/tessdata
# TESSDATA_PREFIX is also supported as an alias for TESSERACT_TESSDATA_DIR.
